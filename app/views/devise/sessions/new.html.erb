<div class="login-container">
  <div class="login-card">
    <h2 class="login-title">Connexion</h2>
    <p class="login-subtitle">Bienvenue ! Veuillez saisir vos identifiants.</p>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "login-form" }) do |f| %>

      <div class="form-group">
        <%= f.label :email, class: "form-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-input" %>
      </div>

      <div class="form-group">
        <%= f.label :password, class: "form-label" %>
        <%= f.password_field :password, autocomplete: "current-password", class: "form-input" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="form-group form-remember">
          <%= f.check_box :remember_me, class: "form-checkbox" %>
          <%= f.label :remember_me, class: "form-label-inline" %>
        </div>
      <% end %>

      <div class="form-actions">
        <%= f.submit "Se connecter", class: "btn-primary" %>
      </div>
    <% end %>
<div class="pipi">
 <%- if controller_name != 'registrations' %>
  <%= link_to "S'inscrire", new_registration_path(resource_name), class: "btn-secondary" %>
<% end %>

<%- if controller_name != 'passwords' %>
  <%= link_to "Mot de passe oublié ?", new_password_path(resource_name), class: "btn-third" %>
<% end %>
</div>
    </div>
  </div>
</div>
