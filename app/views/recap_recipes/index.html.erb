<section class="recap-scope">
  <h1 class="recap-title">Ma sélection de recettes</h1>
  <% if @recap_recipes.any? %>
    <ul class="recap-list">
      <% @recap_recipes.each do |recap| %>
        <% recipe = recap.recipe %>
        <li class="recap-card">
          <div class="recap-thumb">
            <div class="recap-thumb-plh">
              <% if recipe.image_url.present? %>
                <%= image_tag recipe.image_url, alt: recipe.name, class: "recap-img" %>
              <% else %>
                <span class="recap-thumb-blank">la bouleeette</span>
              <% end %>
            </div>
          </div>
          <div class="recap-main">
            <h3 class="recap-name">
              <%= link_to recipe.name, recipe_path(recipe), class: "recap-link" %>
            </h3>
            <div class="recap-row">
              <div class="recap-meta">
                <span class="meta-item">
                  <%= image_tag "lhorloge.png", alt: "Temps de préparation", class: "meta-icon" %>
                  <%= recipe.time %> min
                </span>
                <span class="meta-item">
                  <%= image_tag "euro.png", alt: "Prix", class: "meta-icon" %>
                  <% if recipe.respond_to?(:price) %>
                    <%= number_to_currency(recipe.price, unit: "€") %>
                  <% end %>
                </span>
              </div>
              <div class="recap-qty"
     data-controller="recipe-count"
     data-recipe-count-min-value="1">
                <button type="button"
          class="recap-qty-btn"
          aria-label="Retirer"
          data-action="recipe-count#decrement">−</button>
                <span class="recap-qty-n"
        data-recipe-count-target="value">
                  <%= recap.respond_to?(:quantity) ? recap.quantity : 1 %>
                </span>
                <button type="button"
          class="recap-qty-btn"
          aria-label="Ajouter"
          data-action="recipe-count#increment">+</button>
              </div>
            </div>
          </div>
        </li>
      <% end %>
    </ul>
    <div class="recap-actions">
      <%= link_to "Valider", ingredients_lists_path, class: "recap-validate" %>
    </div>
  <% end %>
</section>
