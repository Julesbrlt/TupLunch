<section class="recap-scope">
  <h1 class="recap-title">Ma sélection de recettes</h1>
  <% if @recap_recipes.any? %>
    <ul class="recap-list">
      <% @recap_recipes.each do |recap| %>
        <% recipe = recap.recipe %>
        <li class="recap-card">
          <%= link_to recap_recipe_path(recap),
                data: { turbo_method: :delete, turbo_confirm: "Supprimer cette recette ?" },
                class: "btn-recap-destroy" do %>
            <%= image_tag "bin.png", alt: "Supprimer", class: "icon-delete" %>
          <% end %>
          <div class="recap-thumb">
            <div class="recap-thumb-plh">
              <% if recipe.image_url.present? %>
                <%= image_tag recipe.image_url, alt: recipe.name, class: "recap-img" %>
              <% else %>
                <span class="recap-thumb-blank">la bouleeette</span>
              <% end %>
            </div>
          </div>
          <div class="recap-main">
            <h3 class="recap-name">
              <%= link_to recipe.name, recipe_path(recipe), class: "recap-link" %>
            </h3>
            <div class="recap-row">
              <div class="recap-meta">
                <span class="meta-item">
                  <%= image_tag "lhorloge.png", alt: "Temps de préparation", class: "meta-icon" %>
                  <%= recipe.time %> min
                </span>
                <span class="meta-item">
                  <%= image_tag "euro.png", alt: "Prix", class: "meta-icon" %>
                  <% if recipe.respond_to?(:price) %>
                    <%= number_to_currency(recipe.price, unit: "€") %>
                  <% end %>
                </span>
              </div>
              <%= form_with url: servings_recap_recipe_path(recap), method: :patch, class: "recap-qty",
      data: { controller: "recipe-count", recipe_count_min_value: 1 } do %>
                <button type="button"
          class="recap-qty-btn"
          aria-label="Retirer"
          data-action="recipe-count#decrement">−</button>
                <span class="recap-qty-n" data-recipe-count-target="value">
                  <%= recap.servings %>
                </span>
                <button type="button"
          class="recap-qty-btn"
          aria-label="Ajouter"
          data-action="recipe-count#increment">+</button>
                <%= hidden_field_tag :servings, recap.servings, data: { recipe_count_target: "input" } %>
              <% end %>
            </div>
          </div>
        </li>
      <% end %>
    </ul>
    <div class="recap-actions">
      <%= link_to "Valider", ingredients_lists_path, class: "recap-validate" %>
    </div>
  <% end %>
</section>
