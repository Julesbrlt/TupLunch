<div class="swiper-container" data-controller="swiper">
  <div class="swiper-wrapper">
    <%# <div class="card-counter d-flex justify-content-center mt-3">
      <% @profile.total_recipes.times do |index| %>
        <%# <div class="dot" data-counter-target=<%="dot_#{index}"%>
        <%# </div> %>
      <%# <% end %>
    <%# </div> %>
    <% @recipes.each_with_index do |recipe| %>
        <div class="swiper-slide">
      <div class="col-12 d-flex justify-content-center"> <!-- centre la card -->
          <%= link_to recipe_path(recipe), class:"card-img-background", style:"background-image: url(#{recipe.image_url});" do %>
            <div>
              <!-- Infos en bas sur l'image -->
              <div class="card-overlay p-3 text-white">
                <div class="card-info">
                  <h5 class="mb-2"><%= recipe.name %></h5>
                  <div class="d-flex justify-content-between small">
                    <span>💸 <%= recipe.price %> €</span>
                    <span>⏳ <%= recipe.time %> min</span>
                    <span>🍕 <%= recipe.calories %> kcal</span>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
          <!-- Footer en dehors de l'image -->
          <div class="btn-actions position-absolute w-100 d-flex justify-content-around">
            <button type="button" class="btn btn-pass">
              <%= image_tag "close.png", alt: "Passer", class: "btn-icon" %>
            </button>
            <button type="button" class="btn btn-swipe">
              <%= image_tag "chefswipe.png", alt: "Ajouter", class: "btn-icon" %>
            </button>
          </div>
          <!-- Bouton coeur en overlay -->
          <div class="bouton position-absolute top-0 end-0">
            <% if current_user.favorites.exists?(recipe_id: recipe.id) %>
              <span class="text-danger fs-4">❤️</span>
            <% else %>
              <div class="btn-favorite mt-3">
                <%= link_to recipe_favorites_path(recipe),
                    data: { turbo_method: :post }  do %>
                  <div class="rounded-circle">
                    <%= image_tag "heart.png", alt: "Favori", class: "heart-icon" %>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
