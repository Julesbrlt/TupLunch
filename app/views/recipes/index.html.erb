<div class="cont-swiper">
  <div class="swiper-container" data-controller="swiper">
    <div class="swiper-wrapper" data-swipe-target="wrapper">
      <%# <div class="card-counter d-flex justify-content-center mt-3">
        <% @profile.total_recipes.times do |index| %>
        <%# <div class="dot" data-counter-target=<%="dot_#{index}"%>
        <%# </div> %>
        <%# <% end %>
        <%# </div> %>
        <% @recipes.each do |recipe| %>
          <div class="swiper-slide">
            <div class="col-12 d-flex justify-content-center"> <!-- centre la card -->
              <%= link_to recipe_path(recipe), class:"card-img-background", style:"background-image: url(#{recipe.image_url});" do %>
                <div>
                  <!-- Infos en bas sur l'image -->
                  <div class="card-overlay p-3 text-white">
                    <div class="card-info">
                      <h4 class="title-recipe"><%= recipe.name %></h4>
                      <div class="info-recipe d-flex justify-content-between small">
                        <span class="meta-item"><%= image_tag "euro-vert.png", alt: "Prix", class: "meta-icon" %><%= recipe.price %> €</span>
                        <span class="meta-item"><%= image_tag "horlogecouleur.png", alt: "Temps de préparation", class: "meta-icon" %><%= recipe.time %> min</span>
                        <span><%= image_tag "pizza.png", alt: "calories", class: "calorie-icon"%><%= recipe.calories %> kcal</span>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>
              <div class="btn-favorite-index"
              data-controller="update-favorites"
              data-update-favorites-red-url-value="<%= image_path('heart-red.png') %>"
              data-update-favorites-white-url-value="<%= image_path('heart.png') %>">
                <% if user_signed_in? && current_user.favorites.exists?(recipe_id: recipe.id) %>
                  <div class="rounded-circle2">
                    <%= image_tag "heart-red.png",
                      alt: "Favori",
                      class: "heart-icon2",
                      data: { update_favorites_target: "icon" } %>
                  </div>
                <% else %>
                  <%= link_to recipe_favorites_path(recipe),
                    data: { turbo_method: :post, action: "click->update-favorites#toRed" },
                    class: "rounded-circle2" do %>
                    <%= image_tag "heart.png",
                      alt: "Ajouter aux favoris",
                      class: "heart-icon2",
                      data: { update_favorites_target: "icon" } %>
                  <% end %>
                <% end %>
              </div>
              <!-- Footer en dehors de l'image -->
              <div class="btn-actions position-absolute w-100 d-flex justify-content-around">
                <button type="button" class="btn btn-pass" data-action="click->swiper#pass">
                  <%= image_tag "close.png", alt: "Passer", class: "btn-icon" %>
                </button>
                <button type="button"
                  class="btn btn-swipe"
                  data-action="click->swiper#add"
                  data-url="<%= recipe_recap_recipes_path(recipe) %>">
                  <%= image_tag "chefswipe.png", alt: "Ajouter", class: "btn-icon" %>
                </button>
              </div>
              <!-- Bouton coeur en overlay -->
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
  <%# <% if flash[:alert] %>
    <%# <div class="alert alert-warning"><%= flash[:alert] %>
    <%#</div>
  <%# <% end %>
