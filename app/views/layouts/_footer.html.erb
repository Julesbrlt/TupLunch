<footer class="footer">
  <nav class="footer-nav" aria-label="Navigation principale">
    <%= link_to home_path, class: "footer-link" do %>
      <%= image_tag "home.png",  alt: "Accueil", class: "footer-icon" %>
    <% end %>

    <%= link_to ingredients_lists_path, class: "footer-link" do %>
      <%= image_tag "checklist.png",  alt: "Liste", class: "footer-icon" %>
    <% end %>

    <span class="fab-gap" aria-hidden="true"></span>

    <%= link_to chat_path(current_user.chat), class: "footer-link" do %>
      <%= image_tag "frigo-ia.png",  alt: "Chat", class: "footer-icon" %>
    <% end %>

    <%= link_to dashboard_path, class: "footer-link" do %>
      <%= image_tag "user.png", alt: "Profil", class: "footer-icon" %>
    <% end %>
  </nav>

  <!-- Bouton rond au centre, dans le creux -->
  <%= link_to recipes_path, class: "footer-fab" do %>
    <%= image_tag "chef-hat.png", alt: "Recettes", class: "fab-icon" %>
  <% end %>
</footer>
