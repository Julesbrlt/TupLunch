<div class="container-fluid d-flex flex-column py-3" style="height: 80vh;">
  <!-- Zone messages -->
  <div class="card shadow-sm border-0 rounded-4 ">
    <div id="messages" class="card-body flex-grow-1 overflow-auto" style="max-height: 65vh">
      <div class="d-flex align-items-start mb-3">
        <%= image_tag "mascotte.png", alt: "mascotte ia", style: "width: 60px; height: 60px; padding-top: 10px;" %>
        <div class="bubble px-3 py-2 rounded-3 bg-light shadow-sm">
          Je suis TupChef ! Comment puis-je t’aider ?
        </div>
      </div>
      <%= render "messages/messages", messages: @chat.messages %>
    </div>
    <!-- Input -->
    <div id="new_message" class="p-2">
      <%= render "messages/form", chat: @chat, message: Message.new %>
    </div>
  </div>
</div>
