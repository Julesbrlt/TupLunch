<% messages.each do |message| %>
  <% if message.role == "user" %>
    <div class="d-flex justify-content-end mb-3" data-controller="chat-line">
<div class="answer-chat">
        <div class="fw-bold small mb-1">You</div>
        <div><%= message.content %></div>
      </div>
    </div>
  <% else %>
<div class="d-flex align-items-start mb-3">
  <!-- Avatar -->
  <%= image_tag "mascotte.png", alt: "mascotte ia", class: "chat-avatar me-2" %>

  <!-- Contenu (nom + message) -->
  <div>
    <div class="fw-bold small text-muted mb-1">TupChef</div>
    <div class="chat-bubble">
      <%= raw(render_markdown(message.content)) %>
    </div>
  </div>
</div>

  <% end %>
<% end %>
