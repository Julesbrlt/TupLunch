<%= simple_form_for [chat, message], html: { class: "chat-input d-flex align-items-center p-2" } do |f| %>
  <!-- Champ texte -->
  <%= f.input :content,
        placeholder: "Pose ta question !",
        required: true,
        label: false,
        wrapper_html: { class: "flex-grow-1 mb-0" },
        input_html: { class: "form-control margin-2 border-0 shadow-none" } %>
  <!-- Bouton envoyer -->
  <%= f.button :submit, '➤', class: "btn-chat" %>
<% end %>
